# ─────────────────────────────────────────────────────────────────────────────
#  PG Hub Technologies — PUBLIC REPO.  Code only.  All content lives in Google
#  Drive (folder: PGHubTechnologies).
#
#  Everything below is either a secret or private study content. If you are
#  adding a file and it holds knowledge rather than logic, it belongs in Drive,
#  not here. When in doubt: `git status` before you commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────────────────────
tools/credentials.json
tools/.token.json
tools/.token.json*
client_secret*.json
.env
.env.*
!.env.example

# ── Private content — migrated to Google Drive ───────────────────────────────
# A module folder holds content; the only thing in it that is code is its app
# page. Listing it that way round — ignore the folder, un-ignore the one page —
# means a new note, a `.bak` of a data file or a stray export dropped in there
# is private by default. Naming the content instead had already missed
# AgenticAI's six .json.bak files on the first pass.
Java/*
Java/**
!Java/JavaNotes.html

Python/*
Python/**
!Python/PythonNotes.html

Typescript/*
Typescript/**
!Typescript/TypeScriptNotes.html

ProgramLangs/*
ProgramLangs/**
!ProgramLangs/ProgramLangs.html

SpringFramework/*
SpringFramework/**
!SpringFramework/SpringNotes.html

AWS/*
AWS/**
!AWS/AWSNotes.html

Microservice/*
Microservice/**
!Microservice/MicroserviceNotes.html

Kafka/*
Kafka/**
!Kafka/Kafka.html

Temporal/*
Temporal/**
!Temporal/Workflows.html

GraphQL/*
GraphQL/**
!GraphQL/GraphQL.html

gRPC/*
gRPC/**
!gRPC/GrpcHub.html

MCP/*
MCP/**
!MCP/MCP.html

AgenticAI/*
AgenticAI/**
!AgenticAI/AgentAI.html

Kubernetes/*
Kubernetes/**
!Kubernetes/KubernetesNotes.html

ReactJs/*
ReactJs/**
!ReactJs/ReactNotes.html

interview-prep/*
interview-prep/**
!interview-prep/InterviewPrepNotes.html

OTel/*
OTel/**
!OTel/OTelNotes.html

# The hub manifest (module titles, taglines, categories) and the baked
# cross-module index
hub.json
hub-index.json

# Content that belongs to no module: a generated single-page export of the
# Java/Spring/Microservices material, plus its own docs tree.
JavaStackPage/

# The legacy per-module local servers and launchers, superseded by app/store.js
serve_hub.py
start.command

# Migration bookkeeping (maps local files -> Drive IDs; reveals content names)
tools/.migration-state.json
tools/out/

# ── Housekeeping ─────────────────────────────────────────────────────────────
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
package-lock.json
.claude/settings.local.json
